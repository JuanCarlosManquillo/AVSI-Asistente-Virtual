# === AVSI · Asistente Virtual de Salud Integral — Plantilla de configuración ===
# Copia este archivo a .env y completa los valores.
# NUNCA subas el archivo .env real al repositorio.
#
# Nota: n8n no lee este .env automáticamente. Sirve como inventario de los valores
# que debes configurar en las credenciales y nodos de n8n al importar los flujos.
# Donde sea posible, mueve estos valores a la hoja "Config" o a variables de entorno
# de n8n en vez de dejarlos escritos en los nodos.

# --- Google ---
# ID de la hoja de control (pestañas Config, Historial, Reglas_pago, Borradores).
GOOGLE_SHEET_CONFIG_ID=tu_id_de_hoja_config
# La hoja de "Solicitudes" del mes se resuelve en tiempo de ejecución desde
# Config -> clave "solicitudes_id". El Apps Script la rota cada mes.

# --- Evolution API (WhatsApp) ---
EVOLUTION_INSTANCE_NAME=NombreDeTuInstancia
EVOLUTION_API_URL=https://tu-evolution-api
EVOLUTION_API_KEY=tu_api_key

# --- WhatsApp: números (formato internacional sin +, ej. 573001234567) ---
# Recomendado: define el número de la encargada en la hoja Config -> clave
# "telefono_encargada" para no tocar los flujos al cambiarlo.
WHATSAPP_ENCARGADA=57XXXXXXXXXX      # recibe avisos de solicitudes/riesgo (Config: telefono_encargada)
WHATSAPP_BOT=57XXXXXXXXXX            # número del propio asistente
WHATSAPP_IGNORADOS=57XXXXXXXXXX      # otros números/bots a ignorar (separados por coma)

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Zona horaria ---
TZ=America/Bogota
